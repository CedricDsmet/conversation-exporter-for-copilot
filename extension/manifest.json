{
  "manifest_version": 3,
  "name": "Conversation Exporter for Copilot",
  "short_name": "Copilot Exporter",
  "version": "1.0.0",
  "description": "Save the open Microsoft Copilot chat as a structured HTML or Markdown file. Runs only when you click it. Nothing is uploaded.",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Export this Copilot conversation",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
